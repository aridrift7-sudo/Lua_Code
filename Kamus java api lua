listApi.onItemClick=function(l,v,i)
  local selectedClass=listApi.adapter.getItem(i)
  local detailsArray=getClassDetailsArray(selectedClass)
  local currentFilter="all"
  
  local detailDlg=LuaDialog(service)
  detailDlg.setTitle(selectedClass)
  local dLayout={
    LinearLayout;
    orientation="vertical";
    padding="8dp";
    {
      EditText;
      id="searchDetail";
      layout_width="fill";
      hint="Cari detail...";
    };
    {
      Button;
      id="btnFilter";
      layout_width="fill";
      text="Filter: Semua";
    };
    {
      ListView;
      id="listDetail";
      layout_width="fill";
      layout_height="fill";
    }
  }
  detailDlg.setView(loadlayout(dLayout))
  
  local adapterDetail=ArrayAdapter(service,android.R.layout.simple_list_item_1,{})
  listDetail.adapter=adapterDetail
  
  local function updateDetailList()
    local kw=tostring(searchDetail.getText()):lower()
    local fil={}
    for n=1,#detailsArray do
      local text,type=detailsArray[n][1],detailsArray[n][2]
      local isMatch=(currentFilter=="all" or type=="info" or type==currentFilter)
      if isMatch and (text:lower():find(kw,1,true) or text:find("【")) then
        table.insert(fil,text)
      end
    end
    adapterDetail.clear()
    adapterDetail.addAll(fil)
  end
  
  searchDetail.addTextChangedListener{
    onTextChanged=function()
      updateDetailList()
    end
  }
  
  btnFilter.onClick=function()
    local fItems={"all","superclass","interface","constructor","field","static_field","method","static_method"}
    local fLabels={"Semua","Superclass","Interface","Konstruksi","Field","Static Field","Method","Static Method"}
    
    local filterDlg=LuaDialog(service)
    filterDlg.setTitle("Pilih Kategori")
    local fList=ListView(service)
    fList.adapter=ArrayAdapter(service,android.R.layout.simple_list_item_1,fLabels)
    filterDlg.setView(fList)
    
    fList.onItemClick=function(fl,fv,fPos)
      local title=fLabels[fPos+1]
      currentFilter=fItems[fPos+1]
      btnFilter.setText("Filter: "..title)
      updateDetailList()
      filterDlg.dismiss()
      return true
    end
    filterDlg.show()
  end
  
  updateDetailList()
  
  listDetail.onItemClick=function(ld,vd,id)
    local sInfo=tostring(adapterDetail.getItem(id))
    if not sInfo:find("【") then
      service.copy(sInfo)
      service.speak("Disalin")
    end
    return true
  end
  
  detailDlg.setButton("Salin Semua",function()
    local ft=""
    for n=1,#detailsArray do
      ft=ft..detailsArray[n][1].."\n"
    end
    service.copy(ft)
    service.speak("Salin Berhasil")
  end)
  
  detailDlg.setButton2("Tutup",nil)
  detailDlg.show()
  return true
end

