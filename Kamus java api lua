local function getAllClasses()
  local classList={}
  local uniqueClasses={}

  local function parseJson(jsonObj, prefix)
    if not jsonObj then return end
    local sKeys,keys=pcall(function() return jsonObj.keys() end)
    if not sKeys or not keys then return end
    while keys.hasNext() do
      local key=tostring(keys.next())
      local firstChar=key:sub(1,1)
      if firstChar>='A' and firstChar<='Z' then
        local full=prefix..key
        if not uniqueClasses[full] then
          uniqueClasses[full]=true
          table.insert(classList,full)
        end
      end
      local sNext,nextObj=pcall(function() return jsonObj.getJSONObject(key) end)
      if sNext and nextObj then
        parseJson(nextObj,prefix..key..".")
      end
    end
  end

  local sDex,dexFile=pcall(function() return DexFile(service.getPackageCodePath()) end)
  if sDex and dexFile then
    local entries=dexFile.entries()
    while entries.hasMoreElements() do
      local target=tostring(entries.nextElement())
      if not target:find("^android") and not target:find("^java") and not target:find("^kotlin") then
        local sLoad,cls=pcall(function() return service.getClassLoader().loadClass(target) end)
        if sLoad and cls then
          local sf,fields=pcall(function() return cls.getDeclaredFields() end)
          if sf and fields then
            local jsonFields,mapFields={},{}
            for i=0,#fields-1 do
              local f=fields[i]
              if Modifier.isStatic(f.getModifiers()) then
                local fType=tostring(f.getType())
                if fType=="class org.json.JSONObject" then
                  table.insert(jsonFields,f)
                elseif fType=="class java.util.HashMap" then
                  table.insert(mapFields,f)
                end
              end
            end

            if #jsonFields>0 or #mapFields>0 then
              local sm,methods=pcall(function() return cls.getDeclaredMethods() end)
              if sm and methods then
                local sBind,bCls=pcall(luajava.bindClass,target)
                for i=0,#methods-1 do
                  local m=methods[i]
                  if Modifier.isStatic(m.getModifiers()) then
                    local params=m.getParameterTypes()
                    if params and #params==1 then
                      local pType=tostring(params[0])
                      if pType:find("Context") then
                        m.setAccessible(true)
                        pcall(function() m.invoke(nil,{service}) end)
                        if sBind and bCls then pcall(function() bCls[m.getName()](service) end) end
                      elseif pType:find("String") or pType:find("CharSequence") then
                        m.setAccessible(true)
                        pcall(function() m.invoke(nil,{"android.widget.Button"}) end)
                        if sBind and bCls then pcall(function() bCls[m.getName()]("android.widget.Button") end) end
                      end
                    end
                  end
                end
              end
              
              for i=1,#jsonFields do
                local jf=jsonFields[i]
                jf.setAccessible(true)
                local sJ,jObj=pcall(function() return jf.get(nil) end)
                if sJ and jObj then parseJson(jObj,"") end
              end

              for i=1,#mapFields do
                local mf=mapFields[i]
                mf.setAccessible(true)
                local sM,mObj=pcall(function() return mf.get(nil) end)
                if sM and mObj and type(mObj)=="userdata" then
                  local sV,vals=pcall(function() return mObj.values().iterator() end)
                  if sV and vals then
                    while vals.hasNext() do
                      local arr=vals.next()
                      if arr and type(arr)=="userdata" then
                        local sSz,sz=pcall(function() return arr.size() end)
                        if sSz and type(sz)=="number" then
                          for k=0,sz-1 do
                            local sI,item=pcall(function() return arr.get(k) end)
                            if sI and item then
                              local strItem=tostring(item)
                              if strItem:find("%.") and not uniqueClasses[strItem] then
                                uniqueClasses[strItem]=true
                                table.insert(classList,strItem)
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end

            if #classList>0 then break end
          end
        end
      end
    end
  end

  if #classList==0 then
    classList={
      "com.androlua.LuaActivity","com.androlua.LuaService",
      "com.nirenr.talkman.TalkManAccessibilityService",
      "com.androlua.LuaDialog","com.androlua.Http",
      "android.widget.LinearLayout","android.widget.ListView",
      "android.widget.EditText","android.widget.Button",
      "java.lang.String","java.lang.Math","java.io.File"
    }
  end

  local priority={
    ["com.androlua.LuaActivity"]=1,
    ["com.androlua.LuaService"]=2,
    ["com.nirenr.talkman.TalkManAccessibilityService"]=3,
    ["com.androlua.LuaDialog"]=4,
    ["com.androlua.Http"]=5
  }

  table.sort(classList,function(a,b)
    local pA=priority[a] or (a:find("^com%.androlua%.") and 10 or 999)
    local pB=priority[b] or (b:find("^com%.androlua%.") and 10 or 999)
    if pA~=pB then return pA<pB end
    return a<b
  end)

  return classList
end

local function getClassDetailsArray(className)
  local success,cls=pcall(function() return service.getClassLoader().loadClass(className) end)
  if not success then return {{"Gagal memuat Class","info"}} end
  local details={}
  table.insert(details,{"【Informasi Class】","info"})
  table.insert(details,{className,"info"})
  
  local sSuper,superClass=pcall(function() return cls.getSuperclass() end)
  if sSuper and superClass then
    table.insert(details,{"【Superclass】","superclass"})
    table.insert(details,{superClass.getName(),"superclass"})
  end
  
  local sInt,interfaces=pcall(function() return cls.getInterfaces() end)
  if sInt and interfaces and #interfaces>0 then
    table.insert(details,{"【Interfaces】","interface"})
    for i=0,#interfaces-1 do table.insert(details,{interfaces[i].getName(),"interface"}) end
  end
  
  table.insert(details,{"【Metode Konstruksi】","constructor"})
  local sc,constructors=pcall(function() return cls.getConstructors() end)
  if sc and constructors then
    for i=0,#constructors-1 do
      table.insert(details,{tostring(constructors[i]),"constructor"})
    end
  end
  
  table.insert(details,{"【Bidang (Field)】","field"})
  local sf,fields=pcall(function() return cls.getDeclaredFields() end)
  if sf and fields then
    for i=0,#fields-1 do
      local f=fields[i]
      local mod=f.getModifiers()
      local t=Modifier.isStatic(mod) and "static_field" or "field"
      if Modifier.isPublic(mod) then
        table.insert(details,{tostring(f),t})
      end
    end
  end
  
  table.insert(details,{"【Metode】","method"})
  local sm,methods=pcall(function() return cls.getDeclaredMethods() end)
  if sm and methods then
    for i=0,#methods-1 do
      local m=methods[i]
      local mod=m.getModifiers()
      local t=Modifier.isStatic(mod) and "static_method" or "method"
      if Modifier.isPublic(mod) then
        table.insert(details,{tostring(m),t})
      end
    end
  end
  return details
end

